# Copy to .env.local and fill in. Never commit .env.local.
# Local values match docker-compose.yml.
DATABASE_URL=postgres://smesay:smesay@localhost:5432/smesay
# better-auth reads BETTER_AUTH_SECRET and BETTER_AUTH_URL (node_modules/@better-auth/core/dist/types/init-options.d.mts).
# The secret is a random string, never shared: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
# The site's own address. A production process refuses an http address other than localhost.
BETTER_AUTH_URL=http://localhost:3000
# Mail (stories/E2-1): the compose Mailpit locally; at the launch gate Resend's SMTP endpoint,
# smtps://resend:RESEND_API_KEY@smtp.resend.com:465 (resend.com/docs/send-with-smtp).
MAIL_SMTP_URL=smtp://localhost:1025
EMAIL_FROM=SMEsay <sign-in@localhost>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ANTHROPIC_API_KEY=
# The product's AI spend cap for the month across every workspace, in whole euro (decision 0036).
# Set it to the Console's monthly limit (docs/accounts.md step 9). Missing: every AI call is refused.
ANTHROPIC_MONTHLY_BUDGET_EUR=10
# Object storage (stories/E2-5): the compose RustFS locally, Cloudflare R2 at the launch gate
# (docs/accounts.md step 8). "memory:" keeps objects in the process, for tests only.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=uploads
S3_ACCESS_KEY_ID=smesay
S3_SECRET_ACCESS_KEY=smesay-local
# The Chromium the PDF summary prints with (stories/E10-3) and the e2e tests run in. Empty: the
# browser Playwright downloads (npx playwright install chromium).
PLAYWRIGHT_CHROMIUM_PATH=
# Backups (stories/E11-4, docs/runbooks/backup-restore.md): a folder locally, s3://[BUCKET]/[PREFIX]
# at the launch gate. PG_TOOLS: local (pg_dump on the PATH), compose (the compose postgres
# service, nothing to install) or docker; empty tries the PATH, then compose.
BACKUP_PATH=./backups
PG_TOOLS=
SENTRY_DSN=
PLAUSIBLE_DOMAIN=
APP_URL=http://localhost:3000
