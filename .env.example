# Copy to .env.local and fill in. Never commit .env.local.
# Local values match docker-compose.yml.
DATABASE_URL=postgres://smesay:smesay@localhost:5432/smesay
# better-auth reads BETTER_AUTH_SECRET and BETTER_AUTH_URL (node_modules/@better-auth/core/dist/types/init-options.d.mts). Set in E2.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
ANTHROPIC_API_KEY=
ANTHROPIC_MONTHLY_BUDGET_EUR=50
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=uploads
S3_ACCESS_KEY_ID=smesay
S3_SECRET_ACCESS_KEY=smesay-local
SENTRY_DSN=
PLAUSIBLE_DOMAIN=
APP_URL=http://localhost:3000
