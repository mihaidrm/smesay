# Copy to .env.local and fill in. Never commit .env.local.
# Local values match docker-compose.yml.
DATABASE_URL=postgres://smesay:smesay@localhost:5432/smesay
# better-auth reads BETTER_AUTH_SECRET and BETTER_AUTH_URL (node_modules/@better-auth/core/dist/types/init-options.d.mts).
# The secret is a random string, never shared: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
# The site's own address. A production process refuses an http address other than localhost.
BETTER_AUTH_URL=http://localhost:3000
# Mail (stories/E2-1): the compose Mailpit locally; at the launch gate Resend's SMTP endpoint,
# smtps://resend:RESEND_API_KEY@smtp.resend.com:465 (resend.com/docs/send-with-smtp).
MAIL_SMTP_URL=smtp://localhost:1025
EMAIL_FROM=SMEsay <sign-in@localhost>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
ANTHROPIC_API_KEY=
ANTHROPIC_MONTHLY_BUDGET_EUR=50
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=uploads
S3_ACCESS_KEY_ID=smesay
S3_SECRET_ACCESS_KEY=smesay-local
SENTRY_DSN=
PLAUSIBLE_DOMAIN=
APP_URL=http://localhost:3000
