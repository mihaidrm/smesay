# Copy to .env.local and fill in. Never commit .env.local.
# Local values match docker-compose.yml.
DATABASE_URL=postgres://smesay:smesay@localhost:5432/smesay
# better-auth reads BETTER_AUTH_SECRET and BETTER_AUTH_URL (node_modules/@better-auth/core/dist/types/init-options.d.mts).
# The secret is a random string, never shared: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
# The site's own address. A production process refuses an http address other than localhost.
BETTER_AUTH_URL=http://localhost:3000
# Mail (stories/E2-1): the compose Mailpit locally; at the launch gate Resend's SMTP endpoint,
# smtps://resend:RESEND_API_KEY@smtp.resend.com:465 (resend.com/docs/send-with-smtp).
MAIL_SMTP_URL=smtp://localhost:1025
EMAIL_FROM=SMEsay <sign-in@localhost>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ANTHROPIC_API_KEY=
# The product's AI spend cap for the month across every workspace, in whole euro (decision 0036).
# Set it to the Console's monthly limit (docs/accounts.md step 9). Missing: every real AI call is refused.
ANTHROPIC_MONTHLY_BUDGET_EUR=10
# The developer menu in the sidebar (stories/E4-8; docs/setup.md): AI calls to the stand-in,
# the real model or off, and the month's usage. It shows whenever NODE_ENV is not "production"
# (npm run dev), so this is for a production build only (CI's Playwright run sets it); leave it
# empty on the live product. With the menu, a checkout with no cookie starts on the stand-in
# and spends nothing.
SMESAY_DEV_MENU=
# Object storage (stories/E2-5): the compose RustFS locally, Cloudflare R2 at the launch gate
# (docs/accounts.md step 8). "memory:" keeps objects in the process, for tests only.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=uploads
S3_ACCESS_KEY_ID=smesay
S3_SECRET_ACCESS_KEY=smesay-local
# The Chromium the PDF summary prints with (stories/E10-3) and the e2e tests run in. Empty: the
# browser Playwright downloads (npx playwright install chromium).
PLAYWRIGHT_CHROMIUM_PATH=
# Backups (stories/E11-4, docs/runbooks/backup-restore.md): a folder locally, s3://[BUCKET]/[PREFIX]
# at the launch gate. PG_TOOLS: local (pg_dump on the PATH), compose (the compose postgres
# service, nothing to install) or docker; empty tries the PATH, then compose.
BACKUP_PATH=./backups
PG_TOOLS=
# Error reports (stories/E11-5, docs/accounts.md step 10). Empty: nothing is sent, no Sentry
# code loads.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
# The support address (docs/accounts.md step 11c): the 500 page names it (stories/E11-6; empty,
# it names hello@smesay.app), and the landing page's question bubble (stories/E12-5) mails
# visitors' questions to it; empty, the bubble is hidden and /api/support answers 404. A
# NEXT_PUBLIC_ value is written into the build, server code included, so set it before
# `next build`; changing it later needs a new build (Next's environment-variables guide).
NEXT_PUBLIC_SUPPORT_EMAIL=
# The emails' footer (stories/E12-3): the company's registered address, one line, set once the
# lawyer confirms it (docs/legal/privacy.md). Unset, the footer shows the company name only.
COMPANY_ADDRESS=
# Maintenance: MAINTENANCE=1 answers every request with the maintenance page (read per request),
# MAINTENANCE_MINUTES the minutes it shows (30 when empty).
MAINTENANCE=
MAINTENANCE_MINUTES=
# Visit counts (stories/E13-3, docs/accounts.md step 11): both from the site's settings in
# Plausible; with either empty nothing loads and nothing is sent.
PLAUSIBLE_DOMAIN=
PLAUSIBLE_SCRIPT_SRC=
APP_URL=http://localhost:3000
# The admin page (stories/E13-2, E14): comma separated emails that may open /admin. Empty: the
# page does not exist (404 for everyone).
ADMIN_EMAILS=
